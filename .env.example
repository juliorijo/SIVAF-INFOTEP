POSTGRES_DB=infotep
POSTGRES_USER=sivaf
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

API_PORT=8000
WEB_PORT=3000

# Keep true in production behind an HTTPS reverse proxy.
SIVAF_COOKIE_SECURE=true

# Local OCR: prefer PaddleOCR with Tesseract fallback.
OCR_PROVIDER_FACTORY=packages.ocr.hybrid_provider:create_hybrid_provider
OCR_USE_PADDLE=true
PADDLE_LANG=es
PADDLE_DPI=260
PADDLE_MIN_CONFIDENCE=0.72
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANGUAGES=spa+eng
TESSERACT_TESSDATA_DIR=C:\Users\YOUR_USER\AppData\Local\SIVAF\tessdata
TESSERACT_DPI=300
TESSERACT_PSM=3

# Optional AI-assisted OCR via a local OpenAI-compatible endpoint (for example Ollama).
AI_OCR_BASE_URL=http://127.0.0.1:11434/v1
AI_OCR_API_KEY=
AI_OCR_MODEL=qwen3:14b
AI_OCR_TIMEOUT_SECONDS=45
AI_OCR_MAX_PAGE_SNIPPETS=24
AI_OCR_MAX_CHARS_PER_PAGE=1800
