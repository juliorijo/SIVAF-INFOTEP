POSTGRES_DB=infotep
POSTGRES_USER=sivaf
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

API_PORT=8000
WEB_PORT=3000

# Keep true in production behind an HTTPS reverse proxy.
SIVAF_COOKIE_SECURE=true

# Local OCR: install Tesseract and the Spanish traineddata file first.
OCR_PROVIDER_FACTORY=packages.ocr.tesseract_provider:create_tesseract_provider
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANGUAGES=spa+eng
TESSERACT_TESSDATA_DIR=C:\Users\YOUR_USER\AppData\Local\SIVAF\tessdata
TESSERACT_DPI=300
TESSERACT_PSM=3
